# OpenShell policy for the `orchestrator` sandbox. Render: sed "s/__HOST_IP__/$HOST_IP/g".
# Same schema as policies/openclaw-policy.yaml.tmpl. Least privilege: two network rules, node only.
version: 1

filesystem_policy:
  include_workdir: true
  # Same read-only base as the existing template: runtime, libs, config. Nothing else is readable.
  read_only: [/bin, /usr, /lib, /proc, /dev/urandom, /app, /etc, /var/log]
  # /sandbox holds OpenClaw config + workspace; /tmp is scratch.
  read_write: [/sandbox, /tmp, /dev/null]

landlock:
  compatibility: best_effort

network_policies:
  # Model access: only node (OpenClaw) may reach Ollama on the host. curl stays blocked.
  ollama_host:
    name: ollama-on-host
    endpoints:
      - host: __HOST_IP__
        port: 11434
        # Host IP is private; proxy blocks private IPs unless listed.
        allowed_ips: ["__HOST_IP__/32"]
    binaries:
      - { path: /usr/bin/node }

  # Agent-to-agent channel. Sandboxes cannot reach each other, so both use a mailbox on the host.
  # Orchestrator submits tasks and polls for answers. It may NOT pop tasks or write results.
  mailbox_host:
    name: mailbox-on-host
    endpoints:
      - host: __HOST_IP__
        port: 8090
        allowed_ips: ["__HOST_IP__/32"]
        # protocol/rules syntax taken from NemoClaw tests (https example). UNVERIFIED for plain http;
        # if it rejects, remove protocol, enforcement and rules (loses method scoping).
        protocol: rest
        enforcement: enforce
        rules:
          # POST /tasks: hand a task to the store manager.
          - allow: { method: POST, path: "/tasks" }
          # GET /results/<id>: read the store manager reply.
          - allow: { method: GET, path: "/results/*" }
    binaries:
      - { path: /usr/bin/node }
